# 这是你唯一需要配置的模型文件。
# 复制为 .env，然后填入模型名、地址和 API Key。
# 不要把 .env 提交到 Git。

# 主模型：负责检索、阅读、综合和规划。
MODEL_NAME=deepseek/deepseek-flash
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=replace-with-your-key

# 备用模型：可选，建议与主模型不同厂商。不需要时保持为空。
BACKUP_MODEL_NAME=
BACKUP_MODEL_BASE_URL=
BACKUP_MODEL_API_KEY=

# 独立审校模型：可选，建议与主模型不同厂商。
# 留空时使用主模型审校。
REVIEW_MODEL_NAME=
REVIEW_MODEL_BASE_URL=
REVIEW_MODEL_API_KEY=

# 可选的免费检索服务配置；留空不影响主流程。
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=

# 夜间自动研究：北京时间。定时器只在这个窗口内尝试启动；
# 即使手工运行 nightly，也会在 DeepSeek 高峰计价时段拒绝启动。
NIGHTLY_START_TIME=00:30
NIGHTLY_LATEST_START_TIME=02:00
NIGHTLY_MAX_RUNTIME_MINUTES=360

# 每晚计划处理的资料量。
NIGHTLY_PAPERS=2
NIGHTLY_REPOS=1
NIGHTLY_CROSS=1

# 每晚验收标准。没有足够可靠材料时系统不会编造，只会报告未达标。
NIGHTLY_MIN_EVIDENCE=1
NIGHTLY_MIN_PROPOSALS=0

# 崩溃、断网或模型服务失效时的恢复设置。
NIGHTLY_RETRY_MAX=3
NIGHTLY_RETRY_DELAY_SECONDS=60
MODEL_RETRY_ATTEMPTS=3
MODEL_RETRY_DELAY_SECONDS=10
MODEL_PRIMARY_RECHECK_SECONDS=300
